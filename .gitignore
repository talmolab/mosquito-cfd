# AMReX build artifacts
*.o
*.mod
*.exe
*.ex
*.a
tmp_build_dir/
o/
f/

# AMReX output files (large)
plt*/
chk*/
*.old

# IAMReX immersed-boundary scratch output
# (force CSVs are copied to forces.csv when a run is kept; raw particle dumps are binary)
IB_Particle_*.csv
particle[0-9]*

# Force-surrogate sweep runner output (PR3): per-config IB CSVs + run_metadata are the
# intermediate corpus produced on the cluster, not committed (provenance lands via PR4's
# dataset.parquet). IB_Particle_*.csv is already ignored above; this covers run_metadata too.
# Generalized to prelim_sweep* (not just the frozen coarse corpus) so the fine-grid pilot's and
# full-corpus follow-on's own runs/ trees are covered too (automate-run-metadata-capture D6 —
# examples/prelim_sweep_fine_pilot/runs/ was previously unmatched).
examples/prelim_sweep*/runs/

# Plotfiles and checkpoints (track selectively if needed)
plotfiles/
checkpoints/

# Visualization tooling output (add-visualization-tooling): mp4 videos are 450KB-1.5MB each, not
# diff-reviewable, and regenerable from source data via scripts/make_flow_video.py /
# make_kinematics_video.py. Scoped by output FILENAME convention, not directory -- --out-dir is
# caller-supplied and arbitrary (matches the IB_Particle_*.csv strategy above: by name, not by the
# directory a run happens to write into).
*_flow_*.mp4
*_kinematics_preview.mp4

# Python / uv
__pycache__/
*.py[cod]
.venv/
venv/
# Note: .python-version is committed for reproducibility (uv best practice)

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Large data files
*.hdf5
*.h5
*.dat
!inputs/*.dat

# Logs
*.log
!tests/fixtures/**/*.log
slurm-*.out

# Local config (not for sharing)
.env
*.local.yaml

# AI assistant local state
# Claude Code: version-control shared dev commands; keep only personal settings out
.claude/settings.local.json
.serena/

# Coverage data
.coverage
.coverage.*
htmlcov/
